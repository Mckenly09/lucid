{
  "expo": {
    "name": "Lucid",
    "slug": "lucid",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "lucid",
    "userInterfaceStyle": "automatic",
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "monochromeImage": "./assets/images/monochrome-icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.mckenly.lucid",
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#000000",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "buildArchs": [
              "arm64-v8a"
            ],
            "useLegacyPackaging": true,
            "kotlinVersion": "2.4.0",
            "extraProguardRules": "-keep class com.imxiqi.rnliveaudiostream.** { *; }"
          },
          "ios": {
            "useFrameworks": "static"
          }
        }
      ],
      "expo-sqlite",
      "expo-secure-store",
      "expo-font",
      "@react-native-firebase/app",
      "@react-native-firebase/auth",
      "@react-native-google-signin/google-signin",
      "expo-image",
      [
        "expo-camera",
        {
          "cameraPermission": "Lucid uses the camera to read a question from your book. Photos stay on your phone.",
          "microphonePermission": "Lucid listens so you can ask by voice. Your voice is never saved or sent.",
          "recordAudioAndroid": true,
          "barcodeScannerEnabled": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Lucid reads a question from a photo you pick. Photos stay on your phone."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "8155d6db-3ea2-494d-ad42-1a3a3280e9b9"
      }
    },
    "owner": "mckenly",
    "ios": {
      "bundleIdentifier": "com.mckenly.lucid",
      "googleServicesFile": "./GoogleService-Info.plist"
    }
  }
}
